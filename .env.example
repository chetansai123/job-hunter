# Copy to .env (git-ignored) and fill in. Both are optional but unlock the big wins:
# APIFY_TOKEN: LinkedIn + X hiring posts from founders/recruiters (≈ $0.002/post, capped to one pull per APIFY_POST_HOURS)
APIFY_TOKEN=
# FIRECRAWL_API_KEY: cloud search → real founder/recruiter LinkedIn profiles per company (free tier 500 credits/month)
FIRECRAWL_API_KEY=
# Free LinkedIn-post discovery (no card): serper.dev = 2,500 free searches; tavily.com = 1,000 free searches / month
SERPER_API_KEY=
TAVILY_API_KEY=
# Password that encrypts the cloud dashboard (set the same value as a GitHub secret named DASH_PASSWORD)
DASH_PASSWORD=
